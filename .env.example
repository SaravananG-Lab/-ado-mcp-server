# Azure DevOps Configuration
AZURE_ORG_URL=https://dev.azure.com/myorg
AZURE_PROJECT_NAME=MyProject
AZURE_PAT=your_personal_access_token_here

# Excel Import Configuration
# Use sample data or your own files from src/data/
EXCEL_FILE_PATH=src/data/sample_stories.csv
# EXCEL_FILE_PATH=src/data/CIP_Desktop_User_stories_ado_version.csv
MAPPING_FILE_PATH=output/ado_traceability_map.json

# Report Generation
REPORT_FORMAT=csv
REPORT_OUTPUT_DIR=./output

# Optional: Logging
LOG_LEVEL=INFO
DEBUG=false
